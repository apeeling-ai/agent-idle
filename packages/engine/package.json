{
  "name": "@agent-idle/engine",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Pure, headless TS reducer for Agent Idle. No DOM, no Node, no fetch. Imported identically by Convex (authority), the CLI daemon (local appraisal), and the app (instant preview).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
