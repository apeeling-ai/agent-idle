+/** Resolve the work mapping for a view, if it carries a (valid) work kind. Pure. */
+function workMapFor(view: CreatureView): { zone: ZoneId; anim: AnimationName } | null {
+  return view.workKind ? (WORK_MAP[view.workKind] ?? null) : null;
+}
