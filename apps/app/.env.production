# PostHog product analytics (web-only; see apps/app/src/analytics.ts and PRIVACY.md).
# Loaded by `vite build` — this is what Vercel production builds use. Values set in the
# Vercel dashboard (real process env) take precedence over this file.
# The key is the publishable client token of the "agent-idle" PostHog EU project (id 219058);
# it ships in the browser bundle by design and is not a secret.
VITE_POSTHOG_KEY=phc_pvF34mqwPJ9C88rk7Bs4c3a4FGweVnFq9njSUr6dfH39
# First-party proxy path (see "rewrites" in vercel.json) so adblockers don't see
# *.posthog.com. The path name deliberately avoids blocklist keywords.
VITE_POSTHOG_HOST=/burrow
